{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".pipeline-selftest",
    "noEmitOnError": true
  },
  "include": [
    "lib/pipeline/**/*.ts",
    "app/api/pipeline/route.ts",
    "scripts/pipeline-selftest.ts"
  ],
  "exclude": ["node_modules", "scripts/test-shims", "lib/jarvis"]
}
