# Only enable loopback provider endpoints on a trusted local server.
PIPELINE_ALLOW_LOOPBACK=false

# Optional comma-separated extra development hostnames.
# PIPELINE_ALLOWED_DEV_ORIGINS=host1,host2

# Lets agent blocks run shell commands in their workspace folder. This is NOT a sandbox:
# commands can reach anything this server process can. Enable only on a trusted local machine.
PIPELINE_ALLOW_COMMANDS=false
